{
  "name": "@sureshprajapat8890/react-native-swipe-confirm",
  "version": "0.1.0",
  "description": "A fully customizable swipe-to-confirm / slide-to-unlock button for React Native, powered by Reanimated and Gesture Handler.",
  "keywords": [
    "react-native",
    "swipe",
    "swipe-to-confirm",
    "slide-to-confirm",
    "slide-to-unlock",
    "swipe-button",
    "slider",
    "reanimated",
    "gesture-handler",
    "expo",
    "ios",
    "android"
  ],
  "license": "MIT",
  "author": "Suresh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sureshprajapat8890/react-native-swipe-confirm.git"
  },
  "bugs": {
    "url": "https://github.com/sureshprajapat8890/react-native-swipe-confirm/issues"
  },
  "homepage": "https://github.com/sureshprajapat8890/react-native-swipe-confirm#readme",
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/commonjs/index.d.ts",
  "source": "./src/index.ts",
  "react-native": "./src/index.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": {
        "types": "./lib/typescript/module/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "bob build",
    "clean": "rimraf lib",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "example": "npm run start --prefix example",
    "rename": "node scripts/rename.js",
    "prepare": "bob build",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.70.0",
    "react-native-gesture-handler": ">=2.0.0",
    "react-native-reanimated": ">=3.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/jest-preset": "^0.87.1",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.1.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "jest": "^30.5.2",
    "prettier": "^3.9.8",
    "react": "19.2.3",
    "react-native": "0.87.1",
    "react-native-builder-bob": "^0.43.1",
    "react-native-gesture-handler": "^3.3.0",
    "react-native-reanimated": "^4.7.0",
    "react-native-worklets": "^0.13.0",
    "rimraf": "^6.0.1",
    "test-renderer": "^1.3.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.1"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "commonjs",
        {
          "esm": true
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
